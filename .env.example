# --- Core ---
AUTH_SECRET=
MONGODB_URI=mongodb://localhost:27017/your-db
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth / OAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (OpenRouter) ---
# Powers the public portfolio chatbot and the admin copilots
# (POST /api/admin/ai/generate-blog, POST /api/admin/ai/optimize-project)
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models (use the provider/model form).
# `openrouter/free` auto-routes to an available free model (zero-credit accounts).
# Paid alternatives once you top up credits: google/gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=